# ─── Contact form email (SMTP) ───────────────────────────────────────────────
# The /contact form posts to /api/contact, which sends mail over SMTP via
# nodemailer. Set these in Vercel → Project → Settings → Environment Variables
# (Production + Preview). The form returns a clear "service unavailable" message
# until SMTP_HOST, SMTP_USER and SMTP_PASS are all set.
#
# Zoho example (recommended): create an app-specific password in Zoho Mail and
# paste it as SMTP_PASS. Port 465 = implicit TLS; use 587 for STARTTLS.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@suv-taraqqiyot.com
SMTP_PASS=
# Where inquiries are delivered (defaults to SMTP_USER if omitted).
SMTP_TO=info@suv-taraqqiyot.com

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://suv-taraqqiyot.com
# Optional: Google Search Console verification token (site-verification).
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
